# Contractor-Bot .gitignore

# Environment variables (never commit real token)
.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
.venv/
env/
.env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Project-specific exports (generated, never commit)
exports/pdf/*
exports/docs/*
exports/preview/*
exports/pdf_database/*
exports/print_queue/*
exports/receipts/*
!exports/pdf/.gitkeep
!exports/docs/.gitkeep
!exports/preview/.gitkeep
!exports/pdf_database/.gitkeep
!exports/print_queue/.gitkeep

# Database (clean start - no data files in repo)
database/*.db
database/*.ods
!database/.gitkeep
!database/tables.ods

# Logs
logs/*.log
!logs/.gitkeep

# LibreOffice lock files
.~lock.*#

# Private - never commit (local AI/working data)
.env
tickets/
docs/
.muse
.mventor
profile.md
PROFILE.md
*VISION*
.vision/
