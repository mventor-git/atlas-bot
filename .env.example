# Contractor-Bot Environment Variables
# =====================================
# Copy this file to .env and fill in your values (.env is gitignored)

# Telegram Bot Token (required, never commit)
# Get from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# Superadmin Telegram chat ID (carried from legacy Labor-Report config)
SUPERADMIN_CHAT_ID=7830528991

# Postgres URL (V1 migration target, multi-site isolation)
# Example: postgresql://user:pass@localhost:5432/contractor_bot
DATABASE_URL=

# Optional: legacy SQLite path (pre-migration only)
# DATABASE_PATH=database/contractor_bot.db

# Optional: Log level override (default: INFO)
# LOG_LEVEL=INFO
