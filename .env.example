# Atlas-Bot Environment Variables
# =====================================
# Copy this file to .env and fill in your values (.env is gitignored)

# Telegram Bot Token (required, never commit)
# Get from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# Superadmin Telegram chat ID (your own user id from @userinfobot)
SUPERADMIN_CHAT_ID=0000000000

# Postgres URL (multi-site backend; empty = local SQLite)
# Example: postgresql://user:pass@localhost:5432/atlas_bot
DATABASE_URL=

# Site identity for this bot instance (fleet: one bot per site + HQ bot)
SITE_ID=default

# Optional: legacy SQLite path (pre-migration only)
# DATABASE_PATH=database/atlas_bot.db

# Optional: Log level override (default: INFO)
# LOG_LEVEL=INFO
